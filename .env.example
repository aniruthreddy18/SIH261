# ---- Database -------------------------------------------------------------
# SQLite file for the self-contained demo. Switch provider in prisma/schema.prisma
# to "postgresql" and use a postgres:// URL for deployment.
DATABASE_URL="file:./dev.db"

# ---- Storage --------------------------------------------------------------
# Private directory for uploaded documents. Must NOT be inside /public.
STORAGE_DIR="./storage"
# Default per-file upload limit (MB). Administrators can lower/raise it in System Settings.
MAX_UPLOAD_MB=15

# ---- Sessions -------------------------------------------------------------
# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Set to "true" when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# ---- Demo mode ------------------------------------------------------------
# Shows the demo account list on the sign-in page. Set to false outside demos.
DEMO_MODE=true

# ---- OCR ------------------------------------------------------------------
# Set to "false" to disable OCR (scanned documents will be flagged as not processable).
OCR_ENABLED=true
# Optional override of the tesseract language data directory (defaults to bundled @tesseract.js-data/eng).
# OCR_LANG_PATH=

# ---- Local AI extraction (optional, offline) -------------------------------
# Fallback for expected fields the label extractor cannot locate. Runs only after the model is
# installed with `npm run ai:setup` (BERT-SQuAD int8, ~119 MB, Apache-2.0). Every AI suggestion
# must be confirmed by a reviewer before validation rules rely on it. Set to false to disable.
AI_EXTRACTION_ENABLED=true
# Optional override of the model file location (defaults to models/bert-squad/bertsquad-12-int8.onnx).
# AI_MODEL_PATH=

# ---- Official issuer verification provider (NOT configured in the demo) ----
# Leave blank unless you hold authorised access to an official verification API.
OFFICIAL_ISSUER_API_URL=
OFFICIAL_ISSUER_API_KEY=
OFFICIAL_ISSUER_NAME=
# Comma-separated document category codes the provider supports, e.g. ACCREDITATION,NOC_PERMISSION
OFFICIAL_ISSUER_CATEGORIES=
OFFICIAL_ISSUER_SOURCE_TYPE=SANDBOX
