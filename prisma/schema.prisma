// Pravah AI — data model.
// SQLite is used for the self-contained demo; every type used here is portable to PostgreSQL
// (switch `provider` and DATABASE_URL). JSON payloads are stored as TEXT for SQLite portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  APPLICANT
  SCRUTINY_OFFICER
  BUREAU_OFFICER
  COMMITTEE_MEMBER
  SENIOR_OFFICIAL
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  PROCESSING
  AUTO_PASSED
  AUTO_FAILED
  REVIEW_REQUIRED
  PROCESSING_FAILED
  RECTIFICATION_REQUIRED
  IN_STAGE_REVIEW
  READY_FOR_AUTHORIZED_REVIEW
  CLOSED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum DocumentState {
  ACTIVE
  WITHDRAWN
}

enum RuleResultStatus {
  PASS
  FAIL
  REVIEW_REQUIRED
  NOT_APPLICABLE
  PROCESSING_FAILED
  PENDING
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSource {
  RULE
  ANOMALY
  VERIFICATION
}

enum FindingStatus {
  OPEN
  INFO_REQUESTED
  ESCALATED
  RECTIFICATION_REQUESTED
  RESOLVED
  DISMISSED
  AUTO_CLEARED
}

enum VerificationStatus {
  VERIFIED
  MISMATCH_DETECTED
  EXPIRED
  VERIFICATION_PENDING
  SOURCE_UNAVAILABLE
  MANUAL_REVIEW_REQUIRED
  NOT_SUPPORTED
}

enum SourceType {
  REAL
  SANDBOX
  SIMULATED
  MANUAL
}

enum RectificationStatus {
  OPEN
  SUBMITTED
  CLOSED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  designation   String?
  passwordHash  String
  role          Role
  institutionId String?
  institution   Institution?   @relation(fields: [institutionId], references: [id])
  /// Regional officers work on one Region; null means all Regions.
  regionId      String?
  region        Region?        @relation(fields: [regionId], references: [id])
  active        Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  notifications Notification[]

  @@index([role])
  @@index([institutionId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Institutions & institutional records (the "available institutional records")
// ---------------------------------------------------------------------------

model Institution {
  id              String                 @id @default(cuid())
  code            String                 @unique
  name            String
  category        String
  state           String
  city            String
  establishedYear Int?
  regionId        String?
  region          Region?                @relation(fields: [regionId], references: [id])
  createdAt       DateTime               @default(now())
  programmes      InstitutionProgramme[]
  applications    Application[]
  users           User[]
  complianceItems ComplianceItem[]

  @@index([regionId])
}

/// An AICTE Region (demo names). Applications are routed to the Region of their institution.
model Region {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  office       String
  sortOrder    Int           @default(0)
  institutions Institution[]
  users        User[]
}

model InstitutionProgramme {
  id               String      @id @default(cuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name             String
  level            String
  approvedIntake   Int
  lastApprovedYear String

  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// Configuration: templates, checklist, document taxonomy
// ---------------------------------------------------------------------------

model DocumentCategory {
  code                 String             @id
  name                 String
  description          String
  expectedFieldsJson   String             @default("[]")
  verificationRequired Boolean            @default(false)
  sortOrder            Int                @default(0)
  requiredBy           RequiredDocument[]
  documents            Document[]
}

model ApplicationTemplate {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  description       String
  active            Boolean            @default(true)
  isSample          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  requiredDocuments RequiredDocument[]
  applications      Application[]
}

model RequiredDocument {
  id           String              @id @default(cuid())
  templateId   String
  template     ApplicationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  categoryCode String
  category     DocumentCategory    @relation(fields: [categoryCode], references: [code])
  label        String
  mandatory    Boolean             @default(true)
  guidance     String?
  sortOrder    Int                 @default(0)

  @@unique([templateId, categoryCode])
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

model Application {
  id                  String                 @id @default(cuid())
  reference           String                 @unique
  institutionId       String
  institution         Institution            @relation(fields: [institutionId], references: [id])
  templateId          String
  template            ApplicationTemplate    @relation(fields: [templateId], references: [id])
  institutionName     String
  institutionCode     String?
  institutionCategory String
  academicYear        String
  /// Application type (e.g. NEW_INSTITUTION); selects the processing pathway.
  applicationType     String                 @default("EXTENSION_OF_APPROVAL")
  /// Pathway assigned on submission (snapshot of its stage list in pathwayStagesJson).
  pathwayCode         String?
  pathwayStagesJson   String?
  /// Current processing stage code (null before submission, CLOSED after the decision).
  currentStage        String?
  status              ApplicationStatus      @default(DRAFT)
  contactName         String
  contactEmail        String
  contactPhone        String?
  createdById         String
  submittedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  programmes          ApplicationProgramme[]
  documents           Document[]
  runs                ValidationRun[]
  findings            Finding[]
  verifications       IssuerVerification[]
  reviewActions       ReviewAction[]
  rectifications      RectificationRequest[]
  statusChanges       StatusChange[]
  complianceNotes     ComplianceNote[]
  stages              StageInstance[]
  evcVisits           EvcVisit[]
  complianceItems     ComplianceItem[]

  @@index([status])
  @@index([institutionId])
  @@index([currentStage])
}

model ApplicationProgramme {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  level         String
  intake        Int

  @@index([applicationId])
}

model StatusChange {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?
  actorLabel    String
  reason        String?
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
}

model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Documents, versions & extraction
// ---------------------------------------------------------------------------

model Document {
  id              String            @id @default(cuid())
  applicationId   String
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  categoryCode    String
  category        DocumentCategory  @relation(fields: [categoryCode], references: [code])
  title           String?
  state           DocumentState     @default(ACTIVE)
  withdrawnAt     DateTime?
  withdrawnReason String?
  createdAt       DateTime          @default(now())
  versions        DocumentVersion[]
  findings        Finding[]

  @@index([applicationId])
}

model DocumentVersion {
  id               String           @id @default(cuid())
  documentId       String
  document         Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNo        Int
  isCurrent        Boolean          @default(true)
  storageKey       String           @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  uploadedById     String
  uploadedAt       DateTime         @default(now())
  supersededAt     DateTime?
  processingStatus ProcessingStatus @default(PENDING)
  processingError  String?
  processedAt      DateTime?
  extractionMethod String?
  pageCount        Int?
  ocrConfidence    Float?
  pagesJson        String?
  textContent      String?
  metadataJson     String?
  warningsJson     String           @default("[]")
  fields           ExtractedField[]

  @@unique([documentId, versionNo])
  @@index([sha256])
  @@index([documentId, isCurrent])
}

model ExtractedField {
  id               String          @id @default(cuid())
  versionId        String
  version          DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key              String
  label            String
  value            String?
  normalizedValue  String?
  confidence       Float
  page             Int?
  excerpt          String?
  bboxJson         String?
  method           String
  correctedValue   String?
  correctedById    String?
  correctedAt      DateTime?
  correctionReason String?

  @@unique([versionId, key])
}

// ---------------------------------------------------------------------------
// Rules & validation
// ---------------------------------------------------------------------------

model ValidationRule {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  description    String
  category       String
  active         Boolean       @default(true)
  isSample       Boolean       @default(true)
  currentVersion Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  versions       RuleVersion[]
}

model RuleVersion {
  id              String         @id @default(cuid())
  ruleId          String
  rule            ValidationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version         Int
  checkType       String
  definitionJson  String
  severity        Severity
  appliesToJson   String         @default("[]")
  effectiveFrom   DateTime
  remediation     String
  sourceReference String?
  changeNote      String?
  createdById     String?
  createdAt       DateTime       @default(now())
  results         RuleResult[]

  @@unique([ruleId, version])
}

model ValidationRun {
  id               String             @id @default(cuid())
  applicationId    String
  application      Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  runNumber        Int
  status           RunStatus          @default(RUNNING)
  trigger          String
  startedById      String?
  startedByLabel   String
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  machineOutcome   ApplicationStatus?
  summaryJson      String             @default("{}")
  ruleVersionsJson String             @default("[]")
  correlationId    String
  errorMessage     String?
  results          RuleResult[]

  @@unique([applicationId, runNumber])
}

model RuleResult {
  id                String           @id @default(cuid())
  runId             String
  run               ValidationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  ruleVersionId     String
  ruleVersion       RuleVersion      @relation(fields: [ruleVersionId], references: [id])
  ruleCode          String
  ruleVersionNo     Int
  ruleName          String
  status            RuleResultStatus
  severity          Severity
  subjectKey        String
  subjectLabel      String
  documentId        String?
  documentVersionId String?
  categoryCode      String?
  explanation       String
  expected          String?
  observed          String?
  evidenceJson      String           @default("[]")
  nextAction        String?
  executedAt        DateTime         @default(now())

  @@index([runId])
}

model Finding {
  id                String         @id @default(cuid())
  applicationId     String
  application       Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  source            FindingSource
  fingerprint       String
  type              String
  title             String
  description       String
  severity          Severity
  outcomeClass      String
  isDeterministic   Boolean
  confidence        Float?
  method            String?
  evidenceJson      String         @default("[]")
  recommendedAction String
  status            FindingStatus  @default(OPEN)
  assignedRole      Role?
  documentId        String?
  document          Document?      @relation(fields: [documentId], references: [id])
  ruleCode          String?
  ruleVersionNo     Int?
  verificationId    String?
  evidenceKey       String?
  firstRunId        String?
  lastRunId         String?
  resolvedAt        DateTime?
  resolvedById      String?
  resolutionNote    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  reviewActions     ReviewAction[]

  @@index([applicationId, status])
  @@index([fingerprint])
  @@index([status, severity])
}

// ---------------------------------------------------------------------------
// Issuer verification
// ---------------------------------------------------------------------------

model IssuerSource {
  id             String     @id
  name           String
  sourceType     SourceType
  description    String
  enabled        Boolean    @default(true)
  categoriesJson String     @default("[]")
  configJson     String     @default("{}")
  updatedAt      DateTime   @updatedAt
}

model SyntheticIssuerRecord {
  id              String  @id @default(cuid())
  referenceNumber String  @unique
  categoryCode    String
  issuerName      String
  institutionName String
  institutionCode String
  issueDate       String?
  expiryDate      String?
  recordStatus    String  @default("ACTIVE")
  behaviour       String  @default("NORMAL")
  extraJson       String  @default("{}")
  note            String?
}

model IssuerVerification {
  id                String             @id @default(cuid())
  applicationId     String
  application       Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId        String
  documentVersionId String
  sourceId          String
  sourceName        String
  sourceType        SourceType
  status            VerificationStatus
  referenceNumber   String?
  requestedAt       DateTime           @default(now())
  respondedAt       DateTime?
  attempts          Int                @default(1)
  submittedJson     String             @default("{}")
  returnedJson      String?
  comparisonJson    String             @default("[]")
  limitation        String?
  errorMessage      String?
  responseRef       String?
  actorId           String?
  actorLabel        String
  isManual          Boolean            @default(false)
  manualReason      String?
  correlationId     String

  @@index([applicationId])
  @@index([documentVersionId])
}

// ---------------------------------------------------------------------------
// Compliance
// ---------------------------------------------------------------------------

model ComplianceRequirement {
  id                     String    @id @default(cuid())
  code                   String    @unique
  name                   String
  area                   String
  description            String
  appliesToJson          String    @default("[]")
  evidenceCategoriesJson String    @default("[]")
  linkedRuleCodesJson    String    @default("[]")
  ruleSource             String
  sourceReference        String?
  effectiveFrom          DateTime?
  isSample               Boolean   @default(true)
  remediation            String
  version                Int       @default(1)
  active                 Boolean   @default(true)
}

model ComplianceNote {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirementCode String
  note            String
  authorId        String
  authorName      String
  createdAt       DateTime    @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Review, rectification, notifications, audit
// ---------------------------------------------------------------------------

model ReviewAction {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  findingId     String?
  finding       Finding?    @relation(fields: [findingId], references: [id])
  actorId       String
  actorName     String
  actorRole     Role
  action        String
  outcome       String?
  reason        String
  reference     String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([findingId])
}

model RectificationRequest {
  id             String              @id @default(cuid())
  applicationId  String
  application    Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    String
  message        String
  findingIdsJson String              @default("[]")
  status         RectificationStatus @default(OPEN)
  dueDate        DateTime?
  createdAt      DateTime            @default(now())
  submittedAt    DateTime?
  submittedById  String?
  responseNote   String?
  closedAt       DateTime?

  @@index([applicationId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  severity  Severity?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

/// Append-only. Rows are only ever inserted through src/server/audit.ts and a database
/// trigger (see migration `audit_append_only`) rejects UPDATE and DELETE.
model AuditEvent {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  actorId         String?
  actorLabel      String
  actorRole       String?
  applicationId   String?
  documentId      String?
  eventType       String
  action          String
  beforeJson      String?
  afterJson       String?
  reason          String?
  validationRunId String?
  ruleVersion     String?
  verificationRef String?
  correlationId   String?

  @@index([applicationId, createdAt])
  @@index([eventType])
  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ---------------------------------------------------------------------------
// Approval workflow (PS 26262): configurable stages, pathways and routing
// ---------------------------------------------------------------------------

/// A processing stage and its timeline. Values are sample configuration editable by the
/// administrator; they are not taken from the Approval Process Handbook.
model StageConfig {
  code                  String   @id
  name                  String
  description           String
  /// Role that must act at this stage (receives reminders and level-1 escalations).
  responsibleRole       Role
  slaDays               Int
  /// Shorter timeline for applications from new institutions (null = same as slaDays).
  newInstitutionSlaDays Int?
  reminderDaysBefore    Int      @default(3)
  /// Days overdue before escalating to the Bureau (level 2) and the competent authority (level 3).
  escalateL2AfterDays   Int      @default(3)
  escalateL3AfterDays   Int      @default(10)
  sortOrder             Int      @default(0)
  updatedAt             DateTime @updatedAt
}

/// An ordered combination of stages, e.g. Scrutiny + EVC.
model PathwayConfig {
  code        String @id
  name        String
  description String
  stagesJson  String
  sortOrder   Int    @default(0)
}

/// Which pathway an application type follows (sample mapping; configure per the applicable APH).
model ApplicationTypeRoute {
  applicationType  String   @id
  name             String
  pathwayCode      String
  isNewInstitution Boolean  @default(false)
  sortOrder        Int      @default(0)
  updatedAt        DateTime @updatedAt
}

enum StageStatus {
  ACTIVE
  COMPLETED
  RETURNED
}

/// One visit of an application to a stage. A stage can be visited again (re-scrutiny, or a
/// return from a later stage), so history is kept as separate rows.
model StageInstance {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageCode       String
  attempt         Int         @default(1)
  status          StageStatus @default(ACTIVE)
  enteredAt       DateTime    @default(now())
  dueAt           DateTime
  completedAt     DateTime?
  completedById   String?
  completedByName String?
  outcome         String?
  remarks         String?
  reference       String?
  /// Highest escalation level already raised for this visit (0 = none).
  escalationLevel Int         @default(0)
  evcVisits       EvcVisit[]

  @@index([applicationId, enteredAt])
  @@index([status, dueAt])
  @@index([stageCode, status])
}

enum EvcStatus {
  AWAITING_SCHEDULE
  SCHEDULED
  REPORT_SUBMITTED
  CANCELLED
}

/// Expert Visit Committee visit for an application in the EVC stage.
model EvcVisit {
  id                String        @id @default(cuid())
  applicationId     String
  application       Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageInstanceId   String
  stageInstance     StageInstance @relation(fields: [stageInstanceId], references: [id], onDelete: Cascade)
  status            EvcStatus     @default(AWAITING_SCHEDULE)
  /// The visit must be scheduled by this date.
  scheduleBy        DateTime
  visitDate         DateTime?
  committeeJson     String        @default("[]")
  convenorId        String?
  convenorName      String?
  scheduledById     String?
  scheduledByName   String?
  scheduledAt       DateTime?
  rescheduleCount   Int           @default(0)
  reportSubmittedAt DateTime?
  recommendation    String?
  reportSummary     String?
  reportReference   String?
  createdAt         DateTime      @default(now())

  @@index([status, scheduleBy])
  @@index([convenorId])
  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Institutional compliance: time-bound undertakings and prescribed document validity
// ---------------------------------------------------------------------------

enum ComplianceKind {
  UNDERTAKING
  DOCUMENT_VALIDITY
}

enum ComplianceStatus {
  OPEN
  SUBMITTED
  FULFILLED
  WAIVED
}

model ComplianceItem {
  id              String                 @id @default(cuid())
  institutionId   String
  institution     Institution            @relation(fields: [institutionId], references: [id])
  applicationId   String?
  application     Application?           @relation(fields: [applicationId], references: [id])
  kind            ComplianceKind
  /// Undertaking or document type code, e.g. LEASE_DEED, FIRE_NOC, FACULTY_RECRUITMENT.
  typeCode        String
  title           String
  description     String
  /// Certificate / deed number for documents; condition reference for undertakings.
  reference       String?
  /// Undertaking due date, or the document's current "valid until" date.
  dueDate         DateTime
  status          ComplianceStatus       @default(OPEN)
  createdById     String?
  createdByName   String
  createdAt       DateTime               @default(now())
  closedAt        DateTime?
  closedNote      String?
  escalationLevel Int                    @default(0)
  submissions     ComplianceSubmission[]

  @@index([institutionId])
  @@index([kind, status, dueDate])
}

enum SubmissionReview {
  PENDING
  ACCEPTED
  RETURNED
}

/// Evidence for an undertaking or a renewed document, uploaded by the institution and
/// verified (or returned) by an authorised official.
model ComplianceSubmission {
  id              String           @id @default(cuid())
  itemId          String
  item            ComplianceItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  sha256          String
  storageKey      String
  note            String
  newValidUntil   DateTime?
  newReference    String?
  submittedById   String
  submittedByName String
  submittedAt     DateTime         @default(now())
  review          SubmissionReview @default(PENDING)
  reviewerId      String?
  reviewerName    String?
  reviewRemarks   String?
  reviewedAt      DateTime?

  @@index([itemId, submittedAt])
  @@index([review])
}

// ---------------------------------------------------------------------------
// Alerts and escalations
// ---------------------------------------------------------------------------

/// Every reminder, overdue alert and escalation the alert engine raises. `dedupeKey` makes the
/// sweep idempotent: the same alert is never raised twice.
model Alert {
  id              String    @id @default(cuid())
  kind            String
  subjectType     String
  subjectId       String
  applicationId   String?
  institutionId   String?
  regionId        String?
  level           Int       @default(0)
  title           String
  body            String
  link            String?
  severity        Severity
  dedupeKey       String    @unique
  recipients      Int       @default(0)
  recipientRoles  String    @default("")
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  acknowledgeNote String?

  @@index([kind, createdAt])
  @@index([subjectType, subjectId])
  @@index([resolvedAt])
}
